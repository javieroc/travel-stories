---
import StoryCard from "./StoryCard.astro";
import cardImage from '../assets/card-image.jpg';
import { fetchApi } from '../lib/strapi';
import type { Story } from '../interfaces/story';

const articles = await fetchApi<Story[]>({
  endpoint: 'travel-stories',
  wrappedByKey: 'data',
});

console.log('articles', articles)
---

<div class="flex flex-wrap gap-4">
	<StoryCard story={{ image: cardImage.src, title: 'Amazing story title', body: 'Lorem ipsum dolor sit amet consectetur adipisicing elit. Nam ducimus enim distinctio sed consectetur error ipsa illo. Placeat, voluptate ipsum. Fuga deleniti nulla similique minima cumque, quae doloribus rem soluta!'}} />
</div>
